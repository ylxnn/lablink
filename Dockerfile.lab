FROM node:22-alpine AS frontend
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --workspaces=false
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /srv
COPY requirements.lab.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lab.lock.txt
COPY backend/ ./backend/
COPY --from=frontend /backend/app/frontend ./backend/app/frontend
ENV PYTHONPATH=/srv/backend
RUN useradd --create-home lablink && mkdir -p /srv/.local && chown -R lablink:lablink /srv
USER lablink
CMD ["sh","-c","cd backend && alembic -c alembic.lab.ini upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
